# URL pública real de tu sitio (sin barra final). Usada para generar los
# enlaces de agendamiento que se comparten. Si conectas un dominio propio,
# solo cambia este valor — nada se rompe.
NEXT_PUBLIC_SITE_URL=https://tu-proyecto.vercel.app

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend (resend.com > API Keys)
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=citas@tudominio.com

# Wompi (comercios.wompi.co > Configuración > Eventos)
WOMPI_EVENTS_SECRET=tu-secreto-de-eventos

# Secreto para proteger la tarea automática de desactivación (invéntalo tú, ej. una cadena larga aleatoria)
CRON_SECRET=un-texto-largo-y-aleatorio-que-tu-inventes
